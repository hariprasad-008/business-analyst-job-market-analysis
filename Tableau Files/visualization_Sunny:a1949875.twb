            <column caption='BA skill %' datatype='real' default-format='p0.0%' name='[Calculation_3158319283851268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [role_category] = &quot;Business Analysis&quot; THEN [job_link] END) / 4689' />
