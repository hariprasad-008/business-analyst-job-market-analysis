      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0v1rayy1ykgnr013iq6q81lyf0n9].[usr:Calculation_3158319283777539:qk]&quot;' value='All BA-related (n=8,610)' />
          <alias key='&quot;[federated.0v1rayy1ykgnr013iq6q81lyf0n9].[usr:Calculation_3158319283851268:qk]&quot;' value='Core Business Analysis (n=4,689)' />
          <alias key='&quot;[federated.0v1rayy1ykgnr013iq6q81lyf0n9].[usr:Calculation_3158319283953669:qk]&quot;' value='Other BA-related roles' />
        </aliases>
      </column>
      <column caption='Skill Filter' datatype='boolean' name='[Calculation_3158319280971776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[job_skills_normalized] IN (&#10;&quot;communication&quot;,&#10;&quot;problem solving&quot;,&#10;&quot;project management&quot;,&#10;&quot;data analysis&quot;,&#10;&quot;analytical skills&quot;,&#10;&quot;sql&quot;,&#10;&quot;leadership&quot;,&#10;&quot;teamwork&quot;,&#10;&quot;agile&quot;,&#10;&quot;microsoft office&quot;,&#10;&quot;requirements gathering&quot;,&#10;&quot;documentation&quot;,&#10;&quot;jira&quot;&#10;)' />
      </column>
      <column caption='Role Group' datatype='string' name='[Calculation_3158319283105794]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [role_category] = &quot;Business Analysis&quot;&#10;THEN &quot;Core Business Analysis&quot;&#10;ELSE &quot;Other BA-related roles&quot;&#10;END' />
      </column>
      <column caption='All skill %' datatype='real' default-format='p0.0%' name='[Calculation_3158319283777539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([job_link]) / 8610' />
      </column>
      <column caption='BA skill %' datatype='real' default-format='p0.0%' name='[Calculation_3158319283851268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [role_category] = &quot;Business Analysis&quot; THEN [job_link] END) / 4689' />
      </column>
      <column caption='Non-BA skill %' datatype='real' default-format='p0.0%' name='[Calculation_3158319283953669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [role_category] &lt;&gt; &quot;Business Analysis&quot; THEN [job_link] END) / 3921' />
      </column>
      <column caption='Skill group' datatype='string' name='[Calculation_3158319284633606]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [job_skills_normalized] IN (&quot;communication&quot;,&quot;problem solving&quot;,&quot;leadership&quot;)&#10;THEN &quot;A  Overall-frequency skills&quot;&#10;ELSEIF [job_skills_normalized] IN (&quot;requirements gathering&quot;,&quot;documentation&quot;,&quot;jira&quot;)&#10;THEN &quot;B  Core-BA practice skills&quot;&#10;END' />
      </column>
