            <column caption='Skill Filter' datatype='boolean' name='[Calculation_3158319280971776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[job_skills_normalized] IN (&#10;&quot;communication&quot;,&#10;&quot;problem solving&quot;,&#10;&quot;project management&quot;,&#10;&quot;data analysis&quot;,&#10;&quot;analytical skills&quot;,&#10;&quot;sql&quot;,&#10;&quot;leadership&quot;,&#10;&quot;teamwork&quot;,&#10;&quot;agile&quot;,&#10;&quot;microsoft office&quot;,&#10;&quot;requirements gathering&quot;,&#10;&quot;documentation&quot;,&#10;&quot;jira&quot;&#10;)' />
            </column>
            <column caption='All skill %' datatype='real' default-format='p0.0%' name='[Calculation_3158319283777539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([job_link]) / 8610' />
